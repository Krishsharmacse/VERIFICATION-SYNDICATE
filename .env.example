# .env.example
# Copy this file to .env and fill in your actual values

# Google Gemini API (Get from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Project (Optional - for Vertex AI)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# Redis Configuration (Optional - for caching/state management)
REDIS_URL=redis://localhost:6379/0

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
# ==================== API KEYS ====================

# Google Fact Check API Key
# Get from: https://developers.google.com/fact-check/tools/api
GOOGLE_FACT_CHECK_API_KEY=AIzaSyCsYxhOkIimy-Yv8ZJ1tDH5qivJW2FtBJ4

# Gemini API Key (new SDK)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyCk5QZJiaEARb_0cN68RAWKX2sZRktHt44

# NewsAPI.org Key
# Get from: https://newsapi.org/register
NEWS_API_KEY=b218d1425d684b7192641b404096d865

# ==================== OPTIONAL API KEYS ====================

# Apify Token (optional - for web scraping)
# Get from: https://console.apify.com/
# APIFY_TOKEN=your_apify_token_here

# ==================== CONFIGURATION FLAGS ====================

# Use free GNews instead of NewsAPI (true/false)
# If true, install: pip install gnews
USE_FREE_GNEWS=false

# ==================== APPLICATION SETTINGS ====================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL=3600

# Request timeout in seconds
REQUEST_TIMEOUT=15

# Maximum claims to extract per article
MAX_CLAIMS=3

# Maximum search results per source
MAX_SEARCH_RESULTS=5

# ==================== PROXY SETTINGS (if needed) ====================

# HTTP Proxy (optional)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# ==================== USER AGENT ====================

# Custom User Agent for Wikipedia
WIKI_USER_AGENT=FactChecker/1.0
open_router=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